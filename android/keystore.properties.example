# Bu dosyayi 'keystore.properties' olarak kopyalayip gercek degerleri gir.
# keystore.properties gitignore'dadir; ASLA commit etme.
#
# Keystore uretimi (bir kez, yedegini mutlaka al - kaybedersen uygulamayi
# bir daha guncelleyemezsin):
#   keytool -genkeypair -v -keystore budget-watchdog-upload.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias upload
#
# storeFile yolu android/app/ klasorune GORE cozulur.
storeFile=../../budget-watchdog-upload.jks
storePassword=CHANGEME
keyAlias=upload
keyPassword=CHANGEME
