<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Bulut yedegi: finansal veri hicbir kosulda cihaz disina cikmaz.
         Kullanici yedeklemesi uygulama ici Yedekle/Geri Yukle ile yapilir. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <!-- Cihazdan cihaza aktarim da ayni gerekceyle kapali -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
