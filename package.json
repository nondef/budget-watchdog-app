    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "terser": "^5.4.0",
    "typescript": "~5.6.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "^2.1.10"
