    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/toast": "^8.0.1",
    "@ionic/core": "^8.8.12",
    "@ionic/vue": "^8.8.12",
    "@ionic/vue-router": "^8.8.12",
    "axios": "^1.11.0",
    "chart.js": "^4.4.8",
    "ionicons": "^7.0.0",
    "jeep-sqlite": "^2.8.0",
    "pinia": "^3.0.1",
    "sql.js": "^1.11.0",
    "swiper": "12.2.0",
    "uuid": "14.0.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.3.0",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.2.0",
    "yup": "^1.7.1"
