{
  "name": "budget-watchdog.app",
  "private": false,
  "version": "1.0.0",
  "description": "Offline-first, multi-currency personal finance app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:android": "npm run assets:brand && capacitor-assets generate --android --assetPath \"assets/android\" && node scripts/finalize-android-icons.mjs",
