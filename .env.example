# ─── Logger ayarları ──────────────────────────────────────────────────
# DİKKAT: VITE_ ön ekli değişkenler build sırasında bundle'a gömülür ve
# client tarafında HERKESE AÇIKTIR. Buraya ASLA secret/token/parola koyma.

# Minimum log seviyesi: debug | info | warn | error | fatal
# Boş bırakılırsa: dev'de debug, prod'da info.
VITE_LOG_LEVEL=debug

# Konsola yazım: auto | on | off
#  auto → dev'de açık, prod'da kapalı (localStorage bw_debug=1 ile açılabilir)
#  on   → her ortamda konsola yaz
#  off  → konsola hiç yazma (yalnızca uygulama içi log ekranı)
VITE_LOG_CONSOLE=on

# ─── SQL sorgu logu (Laravel DB::listen benzeri) ──────────────────────
# Çalışan her SQL'i süresi + parametreleriyle konsola basar.
#  auto → dev'de açık, prod'da kapalı
#         (localStorage bw_db_log: '1' zorla açar, '0' dev'de bile kapatır)
#  on   → her ortamda bas
#  off  → hiç basma
VITE_DB_LOG=on

# Yalnızca bu süreyi (ms) aşan sorguları bas. 0 = hepsi. Hatalar her zaman basılır.
VITE_DB_LOG_SLOW=0

# Transaction satırları: off | summary | verbose
#  off     → hiç gösterme, düz SQL akışı (ROLLBACK yine basılır)
#  summary → BEGIN yutulur, kapanışta tek özet satırı
#  verbose → BEGIN/COMMIT/ROLLBACK ham satır olarak
VITE_DB_LOG_TX=off

# ─── Capacitor köprü trafiği ──────────────────────────────────────────
# Capacitor 8, her plugin çağrısını ve sonucun tamamını Logcat'e döküyor
# (v7'de Java tarafındaki "[object Object]" filtresi bunu eliyordu).
# Bu ayar dökümü devralır; SQLite hariç tutulur çünkü VITE_DB_LOG onu
# zaten süre + SQL + satır sayısıyla kaydediyor.
#  off     → köprü tamamen susar1
#  logger  → merkezi logger'a debug/bridge olarak (LogsPage + export'ta görünür)
#  console → doğrudan konsola, logger buffer'ına dokunmaz
VITE_BRIDGE_LOG=logger

# ─── Uygulama bilgileri ───────────────────────────────────────────────
# Ekranlarda gösterilen uygulama adı ve sürümü (tek kaynak).
VITE_APP_NAME='Budget Watchdog'
VITE_APP_VERSION=1.0.0

# Sahte test verisi (sadece dev). Kapatmak için false yapın veya satırı silin.
VITE_SEED_FAKE_DATA=false